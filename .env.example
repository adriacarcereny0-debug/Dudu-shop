# Conexión a Postgres (Neon → Connection string). SECRETO: solo servidor.
DATABASE_URL=postgresql://usuario:contraseña@host/dudu_shop?sslmode=require

# Contraseña del panel, cifrada. Genérala con: npm run hash-password -- "tu-contraseña"
ADMIN_PASSWORD_HASH=

# Cadena aleatoria larga para firmar la sesión (por ejemplo: openssl rand -base64 48)
SESSION_SECRET=
